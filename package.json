{
  "name": "mama-baby-bot",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "corepack pnpm -F @mama/web dev",
    "dev:worker": "corepack pnpm -F @mama/worker dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "db:generate": "corepack pnpm -F @mama/shared db:generate",
    "db:migrate": "corepack pnpm -F @mama/web payload migrate && corepack pnpm -F @mama/shared db:migrate"
  }
}
