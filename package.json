{
  "name": "mama-baby-bot",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm -F @mama/web dev",
    "dev:worker": "pnpm -F @mama/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm -F @mama/shared db:generate",
    "db:migrate": "pnpm -F @mama/web payload migrate && pnpm -F @mama/shared db:migrate"
  }
}
