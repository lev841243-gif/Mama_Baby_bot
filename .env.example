# Домен для Caddy (HTTPS). Локально — localhost (самоподписанный сертификат).
DOMAIN=localhost
# Публичный https-адрес web: отсюда открывается мини-приложение (PUBLIC_URL/app) и юр. страницы.
PUBLIC_URL=https://localhost

POSTGRES_USER=mama
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mama
# DATABASE_URL и REDIS_URL для контейнеров задаёт docker-compose.yml.
# Для pnpm dev на хосте (вместе с compose.dev.yml):
# DATABASE_URL=postgres://mama:change-me@localhost:55432/mama
# REDIS_URL=redis://localhost:56379

# Токен бота из BotFather (бот оформлен на заказчицу, ТЗ 14).
BOT_TOKEN=
# Секрет Payload CMS: openssl rand -hex 32
PAYLOAD_SECRET=
# Секрет для хеша Telegram ID в логах: openssl rand -hex 32
LOG_HASH_SECRET=
# Закрытый режим: Telegram ID через запятую (Лев, автор, 1–3 тестировщика). Добавляются при миграции.
ACCESS_LIST_TG_IDS=
# Закрытый режим, плашка и тестирование — значения до первого сохранения «Настроек проекта» в админке.
# После сохранения действует то, что в админке (app.app_settings), а не env.
# Закрытый режим (ТЗ 14): true — только список доступа, false — бот открыт всем (решение Льва 28.10.2026 на время разработки).
CLOSED_MODE=true
# Плашка и дисклеймер бета-версии.
BETA_BANNER=true
# Идёт тестирование: новые пользователи помечаются тестировщиками. Выключить перед бета-тестом с мамами.
TESTER_PHASE=true
# Календарь навыков и голосовые (этап 2): на время разработки включены (решение Льва 28.10.2026).
# Для мам — только после решения юриста (Р23). Тоже переопределяется «Настройками проекта».
CALENDAR_ENABLED=true
# Сервис речи ещё не выбран (Р4): голосовое «распознаётся» этой фразой-шаблоном.
# FAKE_SPEECH_TEXT=Сегодня пополз, но пока неуверенно

CHANNEL_URL=https://t.me/detimam_pro
LOG_LEVEL=info

# Хранилище медиа: S3-совместимое в РФ (например S3 Beget). Пусто — файлы на диске (volume media).
S3_BUCKET=
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Оплата подписки (TODO Р21): test — тестовая оплата без денег, работает только пока в админке включено
# «Идёт тестирование»; stars — Telegram Stars (после решения заказчицы и юриста); пусто — оплата выключена.
PAYMENT_PROVIDER=test

# Канал автора (ТЗ 9.9): числовой ID канала, где бот — администратор с правом редактировать сообщения.
CHANNEL_ID=
# Прямая ссылка на мини-приложение для кнопки под постом (из BotFather), например https://t.me/<бот>/app
MINIAPP_URL=
# Вызовы worker → web: длинная случайная строка (openssl rand -hex 32). В Docker web доступен по http://web:3000.
INTERNAL_SECRET=
WEB_INTERNAL_URL=http://web:3000
# ИИ для сборки статей из постов канала (TODO Р4): пусто — без ИИ (одна статья на пост); claude — Claude API.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Распознавание текста каруселей (Yandex Vision OCR, TODO Р4). Пусто — карусели помечаются «требует проверки».
YANDEX_VISION_API_KEY=
YANDEX_FOLDER_ID=

# Мониторинг и бэкап (ТЗ 13, docs/ekspluatatsiya.md)
# Алерты в Telegram: ID чата исполнителя (и по желанию автора); бот — ALERT_BOT_TOKEN или основной BOT_TOKEN.
ALERT_CHAT_ID=
ALERT_BOT_TOKEN=
# GlitchTip (профиль monitoring): DSN проекта из интерфейса GlitchTip, хост заменить на glitchtip:8000.
SENTRY_DSN=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://localhost:8000
# Бакет для ежедневных бэкапов (infra/backup/backup.sh), хранение 30 дней. Ключи — те же S3_*.
BACKUP_S3_BUCKET=
